      "destination": "/dashboard.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hq.hiretrial.com.au" }],
      "destination": "/hq.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hq.hiretrial.com.au" }],
      "destination": "/hq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}
