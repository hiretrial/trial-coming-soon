{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "dashboard.hiretrial.com.au" }],
      "destination": "/dashboard.html"
    },
    {
      "source": "/((?!hq.html|api/).*)",
      "has": [{ "type": "host", "value": "hq.hiretrial.com.au" }],
      "destination": "/hq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/candidate-terms",
      "destination": "/candidate-terms.html"
    },
    {
      "source": "/ai-notice",
      "destination": "/ai-notice.html"
    },
    {
      "source": "/acceptable-use",
      "destination": "/acceptable-use.html"
    }
  ],
  "crons": [
    {
      "path": "/api/follow-up-cron",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/eoi-nudge-worker",
      "schedule": "0 23 * * *"
    }
  ]
}
